APP_NAME=OPS Bot
APP_ENV=development
DEBUG=false

TELEGRAM_BOT_TOKEN=
# Allowed private-chat user IDs, comma-separated. Empty denies everyone.
# Administrator Telegram IDs, comma-separated.
TELEGRAM_ADMIN_IDS=
TELEGRAM_ALLOWED_USER_IDS=

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_PARALLEL=1
TELEGRAM_MAX_PARALLEL=4

LEON_OPERATOR=
LEON_API_KEY=
# LEON_MCP_URL=https://YOUR_OPERATOR.mcpserver.leon.aero/mcp

FOREFLIGHT_API_KEY=
FOREFLIGHT_VENDOR_ID=
FOREFLIGHT_API_URL=https://public-api.foreflight.com/public/api

API_TIMEOUT=30

# Optional source cache lifetimes (seconds); existing .env files need no changes.
SNAPSHOT_TIMEOUT=45
SNAPSHOT_SCHEDULE_TTL=30
SNAPSHOT_CREW_TTL=60
SNAPSHOT_WEATHER_TTL=120
SNAPSHOT_BRIEFING_TTL=300
SNAPSHOT_FTL_TTL=60
WEATHER_STALE_HOURS=2
